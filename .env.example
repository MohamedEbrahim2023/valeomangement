# =============================================================================
# SUPABASE & VERCEL PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================

# DATABASE_URL: Your Supabase PostgreSQL Connection String (Transaction or Session Pooler)
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# SESSION_SECRET: Secret key used to sign HMAC-SHA256 authentication tokens
SESSION_SECRET="replace_with_a_long_random_secret_string_for_vercel"

# INITIAL_ADMIN_EMAIL & INITIAL_ADMIN_PASSWORD:
# Auto-provisioned Administrator credentials on first database boot
INITIAL_ADMIN_EMAIL="zad4036@gmail.com"
INITIAL_ADMIN_PASSWORD="AdminPass123!"

# APP_URL: The URL where this application is hosted
APP_URL="https://your-project.vercel.app"
